---
// 浅色 / 深色（星空）主题切换按钮。
// 深色主题为默认（无 data-theme 属性），浅色为 data-theme="light"。
---

<button class="theme-toggle" type="button" aria-label="切换主题">
  <svg class="ic-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
  </svg>
  <svg class="ic-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2em;
    height: 2em;
    margin-left: 1.25em;
    border-radius: 50%;
    border: 1px solid var(--border-faint);
    background: var(--glass-bg);
    color: var(--text-muted);
    cursor: pointer;
    flex-shrink: 0;
    transition: color .2s ease, border-color .2s ease, transform .2s ease, box-shadow .2s ease;
  }
  .theme-toggle:hover {
    color: var(--cyan);
    border-color: var(--border-cyan);
    transform: translateY(-1px);
    box-shadow: 0 0 16px rgba(34, 211, 238, 0.2);
  }
</style>

<script is:inline>
  (function () {
    var btn = document.querySelector('.theme-toggle');
    if (!btn) return;
    var sun = btn.querySelector('.ic-sun');
    var moon = btn.querySelector('.ic-moon');

    function apply(theme) {
      var isLight = theme === 'light';
      if (sun) sun.style.display = isLight ? 'none' : 'block';
      if (moon) moon.style.display = isLight ? 'block' : 'none';
    }

    apply(document.documentElement.getAttribute('data-theme'));

    btn.addEventListener('click', function () {
      var cur = document.documentElement.getAttribute('data-theme');
      var next = cur === 'light' ? 'dark' : 'light';
      if (next === 'light') document.documentElement.setAttribute('data-theme', 'light');
      else document.documentElement.removeAttribute('data-theme');
      try { localStorage.setItem('theme', next); } catch (e) {}
      apply(next);
    });
  })();
</script>