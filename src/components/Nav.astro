---
interface Props {
  active?: 'home' | 'blog' | 'projects' | 'about';
}
const { active } = Astro.props;
const base = import.meta.env.BASE_URL;
const links = [
  { key: 'home',     href: base,              label: 'home' },
  { key: 'blog',     href: base + 'blog',     label: 'blog' },
  { key: 'projects', href: base + 'projects', label: 'projects' },
  { key: 'about',    href: base + 'about',    label: 'about' },
] as const;
---

<nav>
  <a class="logo" href={base}>Tech-Nomad<span class="dot">·</span></a>
  <div class="nav-links">
    {links.map((l) => (
      <a href={l.href} class={active === l.key ? 'active' : ''}>{l.label}</a>
    ))}
  </div>
</nav>

<style>
  nav {
    display: flex;
    align-items: center;
    padding: 1.125em 0;
    border-bottom: 1px solid var(--border-faint);
  }
  .logo {
    font-size: 1.3em;
    font-weight: 900;
    background: linear-gradient(90deg, var(--cyan), var(--indigo), var(--purple));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .logo .dot { color: var(--cyan); -webkit-text-fill-color: var(--cyan); }
  .nav-links {
    margin-left: auto;
    display: flex;
    gap: 1.5em;
    font-size: 0.88em;
    font-weight: 600;
  }
  .nav-links a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .nav-links a:hover { color: var(--cyan); }
  .nav-links a.active {
    color: var(--cyan);
    border-bottom: 2px solid var(--cyan);
    padding-bottom: 4px;
  }
</style>
