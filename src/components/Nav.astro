---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  active?: 'home' | 'blog' | 'projects' | 'about';
}
const { active } = Astro.props;
const base = import.meta.env.BASE_URL;
const links = [
  { key: 'home', href: base, label: 'Home', icon: '<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>' },
  { key: 'blog', href: base + 'blog', label: 'Blog', icon: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>' },
  { key: 'projects', href: base + 'projects', label: 'Projects', icon: '<path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>' },
  { key: 'about', href: base + 'about', label: 'About', icon: '<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>' },
] as const;
---

<nav>
  <a class="logo" href={base}>Tech-Nomad<span class="dot">·</span></a>
  <div class="nav-links">
    {links.map((l) => (
      <a href={l.href} class={active === l.key ? 'active' : ''}>
        <svg class="nav-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={l.icon} />
        <span class="nav-label">{l.label}</span>
      </a>
    ))}
  </div>
  <ThemeToggle />
</nav>

<style>
  nav {
    display: flex;
    align-items: center;
    padding: 1.125em 0;
    border-bottom: 1px solid var(--border-faint);
  }
  .logo {
    font-size: 1.3em;
    font-weight: 900;
    background: linear-gradient(90deg, var(--cyan), var(--indigo), var(--purple));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .logo .dot { color: var(--cyan); -webkit-text-fill-color: var(--cyan); }
  .nav-links {
    margin-left: auto;
    display: flex;
    gap: 1.5em;
    font-family: var(--font-sans);
    font-size: 0.88em;
    font-weight: 600;
  }
  .nav-links a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }
  .nav-icon {
    flex: 0 0 auto;
    opacity: 0.85;
  }
  .nav-links a:hover { color: var(--cyan); }
  .nav-links a.active {
    color: var(--cyan);
    border-bottom: 2px solid var(--cyan);
    padding-bottom: 4px;
  }
</style>
