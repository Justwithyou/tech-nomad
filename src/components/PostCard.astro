---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const accent = post.data.accent ?? 'cyan';
const base = import.meta.env.BASE_URL;
const href = base + 'blog/' + post.slug;
const dateStr = post.data.published.toISOString().slice(5, 10).replace(/-/g, '.');
---

<a href={href} class={`post-card glass accent-${accent}`}>
  <div class="post-head">
    <div>
      <div class="post-title">{post.data.title}</div>
      <div class="post-desc">{post.data.description}</div>
    </div>
    <span class="post-date">{dateStr}</span>
  </div>
</a>

<style>
  .post-card {
    display: block;
    border-left: 3px solid var(--accent);
    border-radius: 12px;
    padding: 1.25em;
    margin-bottom: 1em;
    color: inherit;
    transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease;
    position: relative;
    overflow: hidden;
  }
  .post-card::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle at 50% 50%, rgba(34, 211, 238, 0.10), transparent 55%);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  .post-card:hover::before { opacity: 1; }
  .post-card:hover {
    transform: translateY(-2px);
    border-color: var(--cyan);
    background: var(--post-hover-bg);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1), 0 0 24px rgba(34, 211, 238, 0.12), 0 0 48px rgba(34, 211, 238, 0.06);
  }
  .post-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .post-title {
    font-size: 0.98em;
    font-weight: 700;
    color: var(--text-title);
  }
  .post-desc {
    font-size: 0.8em;
    color: var(--text-muted);
    margin-top: 0.25em;
  }
  .post-date {
    font-size: 0.68em;
    font-family: var(--font-mono);
    color: var(--accent);
    white-space: nowrap;
    margin-left: 12px;
  }
</style>
