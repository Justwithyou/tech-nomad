---
// Sticky table of contents with IntersectionObserver scroll-spy.
import type { MarkdownHeading } from 'astro';
import SectionHeader from './SectionHeader.astro';

interface Props {
  headings: MarkdownHeading[];
}
const { headings } = Astro.props;
// Only h2 + h3, depth ascending.
const filtered = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<aside class="toc">
  <SectionHeader title="contents" />
  <nav class="toc-nav" aria-label="Table of contents">
    <ul>
      {filtered.map((h) => (
        <li class={h.depth === 3 ? 'sub' : ''}>
          <a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a>
        </li>
      ))}
    </ul>
  </nav>
</aside>

<style>
  .toc {
    position: sticky;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .toc-nav ul {
    list-style: none;
    padding: 0;
    margin: 8px 0 0;
  }
  .toc-nav li {
    margin: 0;
  }
  .toc-nav a {
    display: block;
    color: var(--text-muted);
    padding: 5px 0 5px 10px;
    border-left: 2px solid transparent;
    transition: color .2s ease, border-color .2s ease;
    line-height: 1.5;
  }
  .toc-nav a:hover { color: var(--text-primary); }
  .toc-nav a.active {
    color: var(--cyan);
    border-left-color: var(--cyan);
  }
  .toc-nav li.sub a {
    padding-left: 24px;
    font-size: 12px;
    color: var(--text-meta);
  }

  @media (max-width: 768px) {
    .toc { display: none; }
  }
</style>

<script is:inline>
  (function () {
    var links = Array.prototype.slice.call(document.querySelectorAll('.toc-nav a[data-toc]'));
    if (!links.length) return;
    var map = {};
    links.forEach(function (a) { map[a.getAttribute('data-toc')] = a; });

    var active = null;
    function setActive(id) {
      if (active === id) return;
      active = id;
      links.forEach(function (a) {
        a.classList.toggle('active', a.getAttribute('data-toc') === id);
      });
    }

    var sections = links.map(function (a) {
      var id = a.getAttribute('data-toc');
      return document.getElementById(id);
    }).filter(Boolean);

    if ('IntersectionObserver' in window && sections.length) {
      var observer = new IntersectionObserver(function (entries) {
        // Find the topmost intersecting entry.
        var visible = entries
          .filter(function (e) { return e.isIntersecting; })
          .sort(function (a, b) { return a.boundingClientRect.top - b.boundingClientRect.top; });
        if (visible.length) {
          setActive(visible[0].target.id);
        }
      }, {
        rootMargin: '-72px 0px -70% 0px',
        threshold: [0, 1]
      });
      sections.forEach(function (s) { observer.observe(s); });
    } else {
      // Fallback: scroll listener.
      window.addEventListener('scroll', function () {
        var pos = window.scrollY + 96;
        var current = sections[0] && sections[0].id;
        for (var i = 0; i < sections.length; i++) {
          if (sections[i].offsetTop <= pos) current = sections[i].id;
        }
        if (current) setActive(current);
      }, { passive: true });
    }
  })();
</script>
