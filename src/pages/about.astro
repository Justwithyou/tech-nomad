---
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
---

<Base title="about — Tech-Nomad·" active="about">
  <div class="page">
    <SectionHeader title="about" />
    <article class="glass bio">
      <div class="identity">
        <span class="avatar">Z</span>
        <div class="who">
          <h1 class="name">Zhou</h1>
          <p class="role">独立开发 · AI 产品 · 记录分享</p>
        </div>
      </div>

      <p>
        你好，我是 Zhou，一枚普通的「牛马」打工人，喜欢琢磨各种新东西——代码、AI，还有那些没想明白的问题。
      </p>
      <p>
        这里是我的个人博客，用来记录折腾的过程，也希望能分享和交流。想做出一些有意思的产品，尤其是 AI 产品。如果哪篇文字或某个小工具对你有用，拿去用便是。
      </p>

      <ul class="facts">
        <li><span class="k">// location</span><span class="v">湖南 · 长沙</span></li>
        <li><span class="k">// stack</span><span class="v">Java · Python · AI</span></li>
        <li><span class="k">// focus</span><span class="v">AI 产品 · 折腾新东西</span></li>
        <li><span class="k">// contact</span><span class="v">1904687385@qq.com</span></li>
      </ul>
    </article>
  </div>
</Base>

<style>
  .page {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 3em 0;
  }
  .bio {
    padding: 1.75em 2em;
    color: var(--text-body);
    font-size: 1em;
    line-height: 1.85;
  }
  .bio p { margin: 0.75em 0; }

  .identity {
    display: flex;
    align-items: center;
    gap: 0.875em;
    margin-bottom: 1.375em;
    padding-bottom: 1.125em;
    border-bottom: 1px solid var(--border-faint);
  }
  .avatar {
    width: 3.25em;
    height: 3.25em;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 1.125em;
    font-weight: 700;
    color: var(--bg);
    background: linear-gradient(135deg, var(--cyan), var(--indigo-light), var(--purple));
  }
  .name {
    color: var(--text-title);
    font-size: 1.5em;
    font-weight: 800;
    margin-bottom: 0.125em;
  }
  .role {
    font-family: var(--font-mono);
    font-size: 0.75em;
    color: var(--text-meta);
  }

  .facts {
    list-style: none;
    padding: 0;
    margin: 1.375em 0 0;
    font-family: var(--font-mono);
    font-size: 0.8125em;
  }
  .facts li {
    display: flex;
    gap: 1em;
    padding: 0.375em 0;
    border-bottom: 1px dashed var(--border-faint);
  }
  .facts .k { color: var(--cyan); min-width: 7.5em; }
  .facts .v { color: var(--text-body); }

  @media (max-width: 768px) {
    .bio { padding: 1.375em 1.25em; font-size: 0.9375em; }
    .name { font-size: 1.25em; }
    .facts li { flex-direction: column; gap: 0.125em; }
    .facts .k { min-width: 0; }
  }
</style>
