---
// Base HTML document — wraps every page with starfield + status + nav + footer.
import '../styles/global.css';
import Starfield from '../components/Starfield.astro';
import StatusBar from '../components/StatusBar.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  active?: 'home' | 'blog' | 'projects' | 'about';
}
const { title, active } = Astro.props;
const deployDate = new Date().toISOString().slice(0, 10).replace(/-/g, '.');
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={import.meta.env.BASE_URL + 'favicon.svg'} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Starfield />
    <div class="content">
      <StatusBar date={deployDate} />
      <Nav active={active} />
      <main>
        <slot />
      </main>
      <Footer year={year} deployDate={deployDate} />
    </div>
  </body>
</html>

<style>
  main {
    display: block;
    flex: 1;
  }
  .content {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  footer {
    margin-top: auto;
  }
</style>
